---
import '../styles/global.css';

import SleepTimePicker from '../components/SleepTimePicker.astro';
import RoutineList from '../components/RoutineList.astro';
import SchedulePicker from '../components/SchedulePicker.astro';
---

<!doctype html>
<html lang="id">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />

		<!-- Basic SEO -->
		<title>10·3·2·1 | Rutinitas sebelum tidur</title>

		<meta
			name="description"
			content="Atur rutinitas sebelum tidur dengan metode 10·3·2·1. Tentukan waktu tidur dan lihat jadwal aktivitasmu sebelum tidur."
		/>

		<meta name="robots" content="index, follow" />

		<link
			rel="canonical"
			href="https://10321.rizkirn.my.id/"
		/>

		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="id_ID" />
		<meta property="og:site_name" content="10·3·2·1" />

		<meta
			property="og:title"
			content="10·3·2·1 | Rutinitas sebelum tidur"
		/>

		<meta
			property="og:description"
			content="Atur rutinitas sebelum tidur dengan metode 10·3·2·1. Tentukan waktu tidur dan lihat jadwal aktivitasmu sebelum tidur."
		/>

		<meta
			property="og:url"
			content="https://10321.rizkirn.my.id/"
		/>

		<meta
			property="og:image"
			content="https://10321.rizkirn.my.id/og-image.jpg"
		/>

		<meta
			property="og:image:secure_url"
			content="https://10321.rizkirn.my.id/og-image.jpg"
		/>

		<meta
			property="og:image:type"
			content="image/jpeg"
		/>

		<meta
			property="og:image:width"
			content="1200"
		/>

		<meta
			property="og:image:height"
			content="630"
		/>

		<meta
			property="og:image:alt"
			content="10·3·2·1, rutinitas sebelum tidur"
		/>

		<!-- Twitter / X -->
		<meta
			name="twitter:card"
			content="summary_large_image"
		/>

		<meta
			name="twitter:title"
			content="10·3·2·1 | Rutinitas sebelum tidur"
		/>

		<meta
			name="twitter:description"
			content="Atur rutinitas sebelum tidur dengan metode 10·3·2·1."
		/>

		<meta
			name="twitter:image"
			content="https://10321.rizkirn.my.id/og-image.jpg"
		/>

		<meta
			name="twitter:image:alt"
			content="10·3·2·1, rutinitas sebelum tidur"
		/>

		<!-- Favicon -->
		<link rel="icon" href="/favicon.ico" />

		<!-- Fonts -->
		<link
			rel="preconnect"
			href="https://fonts.googleapis.com"
		/>

		<link
			rel="preconnect"
			href="https://fonts.gstatic.com"
			crossorigin
		/>

		<link
			href="https://fonts.googleapis.com/css2?family=Gaegu:wght@400;700&family=Nunito+Sans:opsz,wght@6..12,400;6..12,600;6..12,700&display=swap"
			rel="stylesheet"
		/>
	</head>

	<body>
		<main class="page">
			<header class="hero">
				<p class="kicker">
					rutinitas sebelum tidur
				</p>

				<h1>10·3·2·1</h1>

				<p class="intro">
					Atur kapan kamu mulai pelan-pelan berhenti dari aktivitas
					sebelum tidur.
				</p>
			</header>

			<SleepTimePicker />

			<RoutineList />

			<SchedulePicker />

			<footer>
				<p>
					Ini panduan umum. Sesuaikan dengan rutinitas dan kebutuhanmu.
				</p>
			</footer>
		</main>

		<script>
			import '../scripts/routine';
			import '../scripts/calendar';
		</script>
	</body>
</html>