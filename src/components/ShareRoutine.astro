<section
	class="share-routine"
	aria-labelledby="share-routine-title"
>
	<div class="section-heading">
		<h2 id="share-routine-title">
			Bagikan rutinitasmu
		</h2>

		<p>
			Buat gambar rutinitas 10·3·2·1 milikmu dan bagikan ke teman.
		</p>
	</div>

	<div class="share-routine-actions">
		<button
			id="share-routine"
			class="share-routine-button"
			type="button"
		>
			Bagikan gambar
		</button>

		<button
			id="save-routine"
			class="share-routine-button secondary"
			type="button"
		>
			Simpan gambar
		</button>
	</div>

	<p
		id="share-routine-status"
		class="share-routine-status"
		aria-live="polite"
		hidden
	></p>
</section>